{
  "name": "quotapet",
  "version": "0.5.0",
  "private": true,
  "description": "A tiny desktop pet that tracks your AI tokens, quotas, and burn rate.",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p apps/desktop/electron/tsconfig.json && cp apps/desktop/electron/preload.cjs dist-electron/preload.cjs",
    "build:renderer": "vite build --config apps/desktop/vite.config.ts",
    "screenshots": "npm run build && electron scripts/capture-screenshots.cjs",
    "check": "npm run build",
    "launch": "node scripts/launch.mjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "ccusage": "^20.0.14",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.2.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
